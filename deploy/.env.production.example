# 复制为部署环境的 .env 后再填写实际值。
# 不要把真实密码、域名证书或数据库备份提交到 Git。

JIZHANGBEN_DOMAIN=ledger.example.com
JIZHANGBEN_CORS_ORIGINS=http://localhost
JIZHANGBEN_SESSION_SAMESITE=none
JIZHANGBEN_SESSION_SECURE=1
JIZHANGBEN_ALLOW_DEV_FALLBACK=0

# 只把应用端口绑定到本机，让公网流量统一经过 Caddy。
JIZHANGBEN_BIND=127.0.0.1
JIZHANGBEN_PORT=8000
