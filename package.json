{
  "name": "jizhangben",
  "private": true,
  "scripts": {
    "pwa:build": "node pwa/build.cjs",
    "pwa:preview": "node pwa/preview-server.cjs",
    "pwa:test": "node --test tests/pwa-build.test.cjs",
    "pwa:prepare:test": "node pwa/prepare-test-package.cjs",
    "pwa:test:package": "node --test tests/pwa-test-package.test.cjs",
    "pwa:storage-lab": "node pwa/storage-lab/server.cjs",
    "pwa:build:storage": "node pwa/build.cjs --storage",
    "pwa:preview:storage": "node pwa/preview-server.cjs --storage",
    "test": "node --test --experimental-test-isolation=none tests/helpers.test.cjs tests/migrations.test.cjs tests/records.test.cjs tests/budget.test.cjs tests/backup.test.cjs tests/external-import.test.cjs tests/record-keyboard.test.cjs tests/category-system.test.cjs tests/investment-plans.test.cjs tests/fixed-income.test.cjs tests/device-security.test.cjs tests/api-client.test.cjs tests/render-and-draft.test.cjs tests/report.test.cjs tests/storage-adapter.test.cjs tests/compact-calendar.test.cjs tests/update-check.test.cjs",
    "benchmark:detail": "node tools/bench-detail.cjs",
    "app:sync": "node mobile/sync-web.cjs",
    "app:sync-capacitor": "npm run app:sync && npx cap sync",
    "app:validate:release": "node mobile/validate-api-url.cjs",
    "app:build:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File mobile/build-debug.ps1",
    "app:build:offline": "powershell -NoProfile -ExecutionPolicy Bypass -File mobile/build-offline.ps1",
    "app:build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File mobile/build-release.ps1",
    "app:install:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File mobile/install-debug.ps1",
    "app:install:offline": "powershell -NoProfile -ExecutionPolicy Bypass -File mobile/install-offline.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capgo/capacitor-webview-crash": "8.1.11"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
