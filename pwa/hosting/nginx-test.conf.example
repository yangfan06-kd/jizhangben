# 仅为审阅模板，未部署、未自动启用。放入独立测试站点的 server 配置。
# 必须通过外层固定 HTTPS 入口访问；8080 仅供本机反向代理。
# root 只指向解压后的 site，不能指向项目、output 或部署包父目录。
server {
    listen 127.0.0.1:8080;
    server_name localhost;
    root /srv/ledger-pwa-test/current/site;
    index index.html;
    autoindex off;
    server_tokens off;
    types {
        text/html html;
        text/javascript js;
        text/css css;
        application/json json;
        application/manifest+json webmanifest;
        image/svg+xml svg;
        image/png png;
    }
    default_type application/octet-stream;
    add_header Cache-Control "no-store, no-transform" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    # 不设置 Clear-Site-Data，不改写 HTML/脚本，不使用 SPA 回退或 .html 去后缀跳转。
    # HTTPS 代理也须保留这些响应头、状态码和原始资源字节。
    location / {
        limit_except GET { deny all; }
        try_files $uri $uri/ =404;
    }
}
